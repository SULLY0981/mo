; Engine configuration file.
config_version=5

[application]

config/name="The Last Lantern"
config/description="Survive the endless night."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.027, 0.02, 0.05, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Save="*res://scripts/save.gd"
Sfx="*res://scripts/audio.gd"
Controls="*res://scripts/controls.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.027, 0.02, 0.05, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
textures/canvas_textures/default_texture_filter=1
