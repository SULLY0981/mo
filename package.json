{
  "name": "the-last-lantern",
  "productName": "The Last Lantern",
  "version": "1.0.0",
  "description": "Survive the endless night. A bullet-heaven roguelite.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "play-browser": "npx http-server game -o -c-1",
    "dist:win": "electron-builder --win dir",
    "dist:linux": "electron-builder --linux dir",
    "dist:mac": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "build": {
    "appId": "com.yourstudio.lastlantern",
    "productName": "The Last Lantern",
    "files": ["game/**/*", "electron/**/*", "package.json"],
    "asarUnpack": ["node_modules/steamworks.js/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "dir" },
    "linux": { "target": "dir", "category": "Game" },
    "mac": { "target": "dir", "category": "public.app-category.games" }
  }
}
